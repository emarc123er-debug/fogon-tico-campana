# Copiar como .env SOLO para pruebas locales. En Railway se configuran en "Variables".
# Nunca subir valores reales a GitHub.

# Postgres de Railway (Railway la inyecta sola al enlazar la base: ${{Postgres.DATABASE_URL}})
DATABASE_URL=

# URL pública de la landing (la usa el MCP para armar los posts)
LANDING_URL=https://tu-app.up.railway.app

# Ruta del servidor MCP. Usá algo difícil de adivinar, ej: mcp-7f3k9x2q
MCP_PATH=mcp

# Copiar como .env SOLO para pruebas locales. En Render se configuran en "Environment".
# Nunca subir valores reales a GitHub.

# Postgres (en Render se conecta sola desde render.yaml)
DATABASE_URL=

# URL pública de la landing (la usa el MCP para armar los posts)
LANDING_URL=https://tu-app.onrender.com

# Ruta del servidor MCP. Usá algo difícil de adivinar, ej: mcp-7f3k9x2q
MCP_PATH=mcp
